# Cloudflare D1 Database Configuration (Persistent Storage for Trade Entries)
# Create a D1 database on Cloudflare using wrangler or the dashboard:
#   npx wrangler d1 create xauusd-indicator-db
# Then copy the IDs and API Token below or into your Vercel Project Environment Variables:

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Server Port (default 3000)
PORT=3000

# Telegram Channel Integration (Automatic & On-Demand High-Confidence Signal Broadcasts)
# 1. Create a Telegram Bot via @BotFather and copy the API token
# 2. Add the bot to your Telegram Channel as an Administrator with "Post Messages" permission
# 3. Use your channel's public username (e.g. @my_signals_channel) or private channel ID (e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTO_BROADCAST=true
TELEGRAM_MIN_SCORE=90
