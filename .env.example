# Cloudflare D1 Database Configuration (Persistent Storage for Trade Entries)
# Create a D1 database on Cloudflare using wrangler or the dashboard:
#   npx wrangler d1 create xauusd-indicator-db
# Then copy the IDs and API Token below or into your Vercel Project Environment Variables:

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Server Port (default 3000)
PORT=3000
